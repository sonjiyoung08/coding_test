# [파이썬 프로그래밍 기초(2) 파이썬의 기본 응용] 5. 객체지향 3

class Student:
    def __init__(self, name):
        self.name = name
    def __str__(self):
        return f'이름: {self.name}'    

class GraduateStudent(Student):
    def __init__(self, name, major):
        super().__init__(name)
        self.major = major

    def __str__(self):
        return f'이름: {self.name}, 전공: {self.major}'
        
student1 = Student("홍길동")
student2 = GraduateStudent("이순신", "컴퓨터")

print(student1)
print(student2)
